# Copie para .env.local e preencha com a config do app Web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Web)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=betina.firebaseapp.com
VITE_FB_PROJECT_ID=betina
VITE_FB_STORAGE_BUCKET=betina.appspot.com
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# Endereço público do site (usado nos links do WhatsApp)
VITE_SITE_URL=https://betina.web.app
